# Flxware environment variables
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
# Required in production. Leave EMPTY during early development: the app then uses
# a development-only in-memory store (not persisted, refused in production).
# Example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/flxware?schema=public
DATABASE_URL=""

# ─── Admin sign-in ─────────────────────────────────────────────────────────
# Shared admin password for /admin (at least 12 characters). Required in production.
# In development, if empty, a random one-time password is printed in the server console.
# Once changed from Admin → Security, the stored hash takes precedence over this value.
ADMIN_PASSWORD=""

# ─── Optional ──────────────────────────────────────────────────────────────
# Where uploaded media is stored. Mount this on a persistent volume in production.
# Defaults to ./uploads
UPLOAD_DIR=""

# Development only: force the in-memory store even when DATABASE_URL is set.
# Ignored when NODE_ENV=production.
# CMS_DATA_SOURCE="dev-memory"
