# Flxware static site — Apache / cPanel configuration.
# Copied into out/ by `npm run build:static`, so it ships with the site.
#
# `headers()` in next.config.ts is a server feature that output: 'export' ignores,
# so the security headers the Node build sends are reproduced here.
#
# Everything below is valid in .htaccess (directory) context. Directives such as
# <LocationMatch> are server-config only and would return 500 here.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Force HTTPS. The site is served over TLS and links are generated as https.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Next's export writes the 404 page at the root.
ErrorDocument 404 /404.html

# Build assets carry a content hash in the filename, so they can be cached forever;
# everything else stays short-lived so edits appear on the next deploy.
#
# SetEnvIf is used because matching by path would need <LocationMatch>, which
# .htaccess does not allow. mod_expires is deliberately not used alongside this:
# it emits its own Cache-Control, and the two would both land on the response.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" IMMUTABLE_ASSET
</IfModule>
<IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
    Header always set Cache-Control "public, max-age=600" env=!IMMUTABLE_ASSET
</IfModule>

# AddOutputFilterByType comes from mod_filter, not mod_deflate — guarding on the
# wrong one lets the directive through where mod_filter is absent, and an unknown
# directive in .htaccess is a 500 on every request.
<IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Don't serve source maps or stray dotfiles. Named explicitly rather than by a
# leading-dot pattern, so /.well-known/ (SSL and domain verification) keeps working.
<FilesMatch "\.(map|env|gitignore|htaccess)$">
    Require all denied
</FilesMatch>
